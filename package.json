{
  "name": "dsh-trae-relay",
  "version": "1.0.0",
  "description": "Managed TRAE CN relay and account console for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "FuSheng-cs",
  "repository": {
    "type": "git",
    "url": "https://github.com/FuSheng-cs/dsh-trae-relay.git"
  },
  "homepage": "https://github.com/FuSheng-cs/dsh-trae-relay#readme",
  "bugs": {
    "url": "https://github.com/FuSheng-cs/dsh-trae-relay/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "python/*.py",
    "vendor/trae2api-cn/src/*.py",
    "vendor/trae2api-cn/LICENSE",
    "vendor/trae2api-cn/requirements.txt",
    "vendor/trae2api-cn/web_login.py",
    "vendor/trae2api-cn/start_auth.bat",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets/*.png",
    "screenshots.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/audit.mjs",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "trae",
    "openai-compatible",
    "relay"
  ]
}
