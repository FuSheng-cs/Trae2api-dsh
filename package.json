{
  "name": "trae2api-dsh",
  "version": "1.3.1",
  "description": "Use TRAE account model quota in DeepSeek Harness, with multi-account management, check-in, rotation and usage statistics",
  "type": "module",
  "license": "MIT",
  "author": "FuSheng-cs",
  "repository": {
    "type": "git",
    "url": "https://github.com/FuSheng-cs/Trae2api-dsh.git"
  },
  "homepage": "https://github.com/FuSheng-cs/Trae2api-dsh#readme",
  "bugs": {
    "url": "https://github.com/FuSheng-cs/Trae2api-dsh/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "python/*.py",
    "vendor/trae2api-cn/src/*.py",
    "vendor/trae2api-cn/LICENSE",
    "vendor/trae2api-cn/requirements.txt",
    "vendor/trae2api-cn/web_login.py",
    "vendor/trae2api-cn/start_auth.bat",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "DISCLAIMER.md",
    "DISCLAIMER.en.md",
    "docs/*.md",
    "CONTRIBUTING.md",
    "MARKETPLACES.md",
    "CHANGELOG.md",
    "assets/*.png",
    "screenshots.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/audit.mjs",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "trae",
    "openai-compatible",
    "relay"
  ],
  "icon": "assets/icon.png"
}
